{
  "name": "homefix-mvp",
  "version": "1.0.0",
  "description": "WhatsApp-first home services AI procurement platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:setup": "node --env-file=.env -e \"import('./src/db/setup.js').then(m => m.setupDatabase())\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.52.0",
    "pg": "^8.12.0",
    "twilio": "^5.2.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
